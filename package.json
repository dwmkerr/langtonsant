{
  "name": "langtonsant",
  "version": "0.2.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwmkerr/langtonsant.git"
  },
  "author": "Dave Kerr",
  "license": "MIT",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "test": "mocha \"src/**/*.spec.js\"",
    "test:watch": "mocha --watch \"src/**/*.spec.js\"",
    "test:debug": "mocha --inspect-brk --watch \"src/**/*.spec.js\"",
    "test:coverage": "nyc --reporter=html --report-dir=./artifacts/coverage mocha \"src/**/*.spec.js\"",
    "test:ci": "nyc --reporter=lcov --reporter=html --report-dir=./artifacts/coverage mocha --reporter mocha-junit-reporter --reporter-options mochaFile=./artifacts/tests/test-report.xml \"src/**/*.spec.js\"",
    "lint": "eslint .",
    "bundle": "webpack --mode production",
    "release": "npm run lint && npm test && standard-version",
    "preversion": "echo 'Version with \"npm run release\"' && exit 1"
  },
  "dependencies": {
    "angular": "^1.8.3",
    "bootstrap3": "^3.3.5",
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chai": "^4.2.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "mocha": "^12.0.0",
    "mocha-junit-reporter": "^2.2.1",
    "nyc": "^18.0.0",
    "standard-version": "^9.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "homepage": "https://dwmkerr.github.io/langtonsant/",
  "engines": {
    "node": ">=20"
  }
}
